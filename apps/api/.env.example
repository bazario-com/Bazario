# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Database
DATABASE_URL=postgresql://marketplace:marketplace_dev_password@localhost:5432/marketplace?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT — generate strong random secrets for real deployments, e.g.:
#   openssl rand -base64 64
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# Cookies
COOKIE_SECRET=replace_with_another_long_random_string

# OAuth (Phase 2 follow-up — placeholders for now)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
